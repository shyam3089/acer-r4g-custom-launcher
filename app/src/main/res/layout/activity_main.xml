<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/wallpaper_mountain" />

    <View
        android:id="@+id/wallpaperScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin_horizontal"
        android:paddingTop="@dimen/home_margin_top"
        android:paddingEnd="@dimen/screen_margin_horizontal"
        android:paddingBottom="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clockText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/text_primary"
                    android:textSize="48sp" />

                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/systemStatsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/system_stats_loading"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/quickSettingsButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/pill_surface"
                    android:contentDescription="@string/open_quick_settings"
                    android:focusable="true"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_menu"
                    android:tint="@color/settings_icon_tint" />

                <ImageButton
                    android:id="@+id/systemSettingsButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/pill_surface"
                    android:contentDescription="@string/android_settings"
                    android:focusable="true"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/settings_icon_tint" />

                <ImageButton
                    android:id="@+id/editButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/pill_surface"
                    android:contentDescription="@string/edit_apps"
                    android:focusable="true"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_edit"
                    android:tint="@color/settings_icon_tint"
                    android:tooltipText="@string/edit_apps" />

                <ImageButton
                    android:id="@+id/allAppsButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/pill_surface"
                    android:contentDescription="@string/all_apps"
                    android:focusable="true"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_all_apps"
                    android:tint="@color/settings_icon_tint"
                    android:tooltipText="@string/all_apps" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:elevation="24dp"
            android:text="@string/home_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appsGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:overScrollMode="never"
            android:paddingStart="20dp"
            android:paddingTop="2dp"
            android:paddingEnd="20dp"
            android:paddingBottom="2dp" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_home_title"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/empty_home_message"
                android:textColor="@color/text_secondary"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/quickSettingsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/quickSettingsDismissArea"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#33000000"
            android:clickable="true"
            android:focusable="false" />

        <FrameLayout
            android:id="@+id/quickSettingsPanel"
            android:layout_width="430dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:layout_margin="22dp"
            android:background="@drawable/quick_panel_background"
            android:clipToOutline="true"
            android:elevation="28dp"
            android:foreground="@drawable/quick_panel_border">

            <ImageView
                android:id="@+id/quickSettingsBlur"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/quick_panel_tint" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="48dp"
                android:paddingTop="38dp"
                android:paddingEnd="48dp"
                android:paddingBottom="38dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:text="@string/quick_settings"
                android:textColor="@color/text_dark"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quickNetworkButton"
                style="@style/QuickSettingsItem"
                android:drawableStart="@drawable/ic_wifi"
                android:nextFocusDown="@id/quickBluetoothButton"
                android:nextFocusLeft="@id/quickNetworkButton"
                android:nextFocusRight="@id/quickNetworkButton"
                android:nextFocusUp="@id/quickNetworkButton"
                android:text="@string/network_settings" />

            <TextView
                android:id="@+id/quickBluetoothButton"
                style="@style/QuickSettingsItem"
                android:drawableStart="@drawable/ic_bluetooth"
                android:nextFocusDown="@id/quickDisplaySoundButton"
                android:nextFocusLeft="@id/quickBluetoothButton"
                android:nextFocusRight="@id/quickBluetoothButton"
                android:nextFocusUp="@id/quickNetworkButton"
                android:text="@string/bluetooth_settings" />

            <TextView
                android:id="@+id/quickDisplaySoundButton"
                style="@style/QuickSettingsItem"
                android:drawableStart="@drawable/ic_display_sound"
                android:nextFocusDown="@id/quickAndroidSettingsButton"
                android:nextFocusLeft="@id/quickDisplaySoundButton"
                android:nextFocusRight="@id/quickDisplaySoundButton"
                android:nextFocusUp="@id/quickBluetoothButton"
                android:text="@string/display_sound_settings" />

            <TextView
                android:id="@+id/quickAndroidSettingsButton"
                style="@style/QuickSettingsItem"
                android:drawableStart="@drawable/ic_settings"
                android:nextFocusDown="@id/quickAndroidSettingsButton"
                android:nextFocusLeft="@id/quickAndroidSettingsButton"
                android:nextFocusRight="@id/quickAndroidSettingsButton"
                android:nextFocusUp="@id/quickDisplaySoundButton"
                android:text="@string/android_settings" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
