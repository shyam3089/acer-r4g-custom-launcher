<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/wallpaper" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="centerCrop" android:src="@drawable/wallpaper_mountain" />
    <View android:id="@+id/wallpaperScrim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/scrim" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="@dimen/screen_margin_horizontal" android:paddingTop="@dimen/screen_margin_vertical" android:paddingEnd="@dimen/screen_margin_horizontal" android:paddingBottom="@dimen/screen_margin_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/appearance" android:textColor="@color/text_primary" android:textSize="34sp" android:textStyle="bold" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/wallpaperGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="26dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:padding="14dp" />
    </LinearLayout>
</FrameLayout>
